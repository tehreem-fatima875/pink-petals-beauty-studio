# Required for persistent MongoDB booking storage. Without this, booking writes are disabled.
MONGODB_URI=

# Auth.js session signing secret; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Optional SMTP confirmation delivery. If unset, the site clearly reports that email is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Central salon details. Use real, verified information before launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SALON_PHONE=
NEXT_PUBLIC_SALON_EMAIL=
NEXT_PUBLIC_SALON_ADDRESS=
NEXT_PUBLIC_SALON_TIMEZONE=America/Los_Angeles

# One-time administrator bootstrap only. Remove these after npm run admin:bootstrap.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
